{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "curl -fsSL https://go.dev/dl/go1.21.6.linux-amd64.tar.gz | tar -C /tmp -xz && PATH=/tmp/go/bin:$PATH hugo --gc --minify",
  "outputDirectory": "public",
  "build": {
    "env": {
      "HUGO_VERSION": "0.161.1"
    }
  },
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  }
}
